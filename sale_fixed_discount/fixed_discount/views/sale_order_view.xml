    <!-- Sale Order Form View - Fixed Discount -->
    <record id="view_order_form_inherit_fixed_discount" model="ir.ui.view">
        <field name="name">sale.order.form.fixed.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- List/Table View မှာ Fixed Discount Column ထည့်ပါ -->
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="after">
                <field name="fixed_discount"
                       widget="monetary"
                       force_save="1"
                       options="{'currency_field': 'currency_id'}"/>
<!--                       sum="Total Disc."/>-->
            </xpath>

        </field>
    </record>

</odoo>


