<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="account_invoice_fixed_discount"
              inherit_id="account.report_invoice_document"
              priority="50">

        <!-- ၁. Table Header - "Fixed Discount" Column -->
        <!-- Amount column ရှေ့မှာ Fixed Discount ထည့်မယ် -->
        <xpath expr="//th[@name='th_subtotal']" position="before">
            <th name="th_fixed_discount" class="text-end">Fixed Discount</th>
        </xpath>

        <!-- ၂. Table Body - Fixed Discount Value -->
        <!-- Invoice Report မှာ 'line' ကိုသုံးပါ -->
        <xpath expr="//td[@name='td_subtotal']" position="before">
            <td name="td_fixed_discount" class="text-end">
                <span t-field="line.fixed_discount"
                      t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
            </td>
        </xpath>

    </template>
</odoo>