    <!-- Account Move Form View - Fixed Discount -->
    <record id="account_move_form_inherit_fixed_discount" model="ir.ui.view">
        <field name="name">account.move.form.fixed.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- List/Table View မှာ Fixed Discount Column ထည့်ပါ -->
            <!-- Odoo 19 မှာ /list မသုံးပါနဲ့ -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='tax_ids']" position="after">
                <field name="fixed_discount"
                       widget="monetary"
                       force_save="1"
                       options="{'currency_field': 'currency_id'}"
                       sum="Total Disc."/>
            </xpath>

        </field>
    </record>
</odoo>