<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the Purchase Order form view to add custom fields -->
    <record id="view_purchase_order_form_inherit_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add fields after the vendor field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="approval_code" placeholder="Auto-generated approval code"/>
                <field name="is_priority"/>
            </xpath>

            <!-- Add a button in the header - using proper xpath to find header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_test_custom_method" type="object"
                        string="Test CRUD"
                        class="btn-secondary"
                        help="Test the custom CRUD override methods"/>
            </xpath>
        </field>
    </record>
</odoo>